# Copy to .env.local for Next.js / local dev (this file is safe to commit).

# --- Runtime (optional; defaults work for local) ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Pinata (required for uploads: voice clips, TTS narration to IPFS) ---
# Get a JWT from Pinata; without this, /api/segments/text/narrate returns 503.
PINATA_JWT=

# Public gateway base for browser-playable URLs (no trailing slash).
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional: dedicated gateway token if your gateway requires ?pinataGatewayToken=
PINATA_GATEWAY_KEY=

# --- Mosi (optional; voice cloning + Mosi TTS voices) ---
MOSI_API_KEY=
# Override API base if needed (default is Mosi studio URL in lib/tts/mosi.ts).
MOSI_BASE_URL=https://studio.mosi.cn

# --- Cron (only if you call /api/cron/refresh-feeds with Authorization) ---
CRON_SECRET=

# --- Kokoro TTS model cache (optional; lib/tts/kokoro.ts sets defaults if unset) ---
# HF_HOME=./workspace/models/kokoro
# TRANSFORMERS_CACHE=./workspace/models/kokoro
