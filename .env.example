# Copy this file to .env.local and fill in the values you need.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.

# --- REQUIRED: Alchemy Smart Wallets (Account Kit) ---------------------------
# Get an API key + smart wallet config: https://dashboard.alchemy.com/apps
NEXT_PUBLIC_ALCHEMY_API_KEY=

# --- RECOMMENDED: ALCHEMY_RPC_URL (server-only) ------------------------------
# ALCHEMY_RPC_URL is optional for local/dev: viem will fall back to the public
# Base RPC. For production, set ALCHEMY_RPC_URL (strongly recommended—treat as
# required) so SIWE verification does not rely on the public endpoint and get
# rate-limited. Use a Base mainnet or Base Sepolia Alchemy URL with your key.
# Example: https://base-mainnet.g.alchemy.com/v2/<your-api-key>
ALCHEMY_RPC_URL=

# --- OPTIONAL: Account Kit tuning --------------------------------------------
# Gas Manager policy for sponsoring UserOperations.
# https://dashboard.alchemy.com/services/gas-manager/configuration
NEXT_PUBLIC_ALCHEMY_POLICY_ID=

# 8453 = Base mainnet (default), 84532 = Base Sepolia (for dev/testing).
NEXT_PUBLIC_CHAIN_ID=8453

# WalletConnect project ID — only needed if you keep the EOA / external-wallet
# login section enabled in config.ts. https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# --- REQUIRED: Pinata (TTS audio + uploads) ----------------------------------
# Without PINATA_JWT, /api/segments/text/narrate returns 503 and segment audio
# uploads fail. https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# Public gateway base for browser-playable URLs (no trailing slash).
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional: dedicated gateway token if your gateway requires ?pinataGatewayToken=
PINATA_GATEWAY_KEY=

# --- OPTIONAL: Mosi voice cloning -------------------------------------------
# If unset, Mosi voice features are disabled and only Kokoro voices appear.
MOSI_API_KEY=
MOSI_SPEECH_MODEL=moss-tts
# Override only if you self-host Mosi.
MOSI_BASE_URL=https://studio.mosi.cn

# --- OPTIONAL: Kokoro local TTS cache ---------------------------------------
# Both default to ./workspace/models/kokoro when unset.
# HF_HOME=./workspace/models/kokoro
# TRANSFORMERS_CACHE=./workspace/models/kokoro

# --- OPTIONAL: SIWE / session Redis -----------------------------------------
# REDIS_URL is optional; omit if you are not using Redis-backed nonce/session
# storage (see lib/auth-storage). When that path is enabled, set REDIS_URL.
REDIS_URL=

# --- OPTIONAL: Cron ---------------------------------------------------------
# Required only if you call /api/cron/refresh-feeds from a scheduled job.
# Send the same value in the x-cron-secret header.
CRON_SECRET=

# --- OPTIONAL: Runtime ------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development